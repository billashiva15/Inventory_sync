<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:file="http://www.mulesoft.org/schema/mule/file"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/file http://www.mulesoft.org/schema/mule/file/current/mule-file.xsd
		http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <file:config name="File_Config" doc:name="File Config" doc:id="d00ebb81-0ed9-4a73-a1d4-a1675087545a" >
		<file:connection workingDir="C:\data\inventory" />
	</file:config>
	<flow name="inventory-file-ingestion-flow">
        <file:listener doc:name="Poll Inventory CSV Files" 
                        config-ref="File_Config" 
                        directory="C:\data\inventory\inbound" 
                        recursive="false" 
                        timeBetweenSizeCheck="2000">
            <scheduling-strategy>
                <fixed-frequency frequency="60000"/>
            </scheduling-strategy>
        </file:listener>
        
        <set-variable
            variableName="sourceFileName"
            value="#[attributes.fileName]"
            doc:name="Capture Source Filename"/>

        <set-variable 
            variableName="correlationId" 
            value="#['file-' ++ vars.sourceFileName]" 
            doc:name="Generate Correlation ID"/>

        <logger
            level="INFO"
            doc:name="Log Detected Warehouse File"
            message="#['[Correlation ID: ' ++ vars.correlationId ++ '] Inventory poll detected file: ' ++ vars.sourceFileName]"/>

        <!-- 1. Save the original file payload before Scatter-Gather -->
        <set-variable variableName="filePayload" value="#[payload]" doc:name="Save File Payload"/>

        <!-- Scatter-Gather as required by mentor -->
        <scatter-gather doc:name="Scatter-Gather File Initialization">
            <route>
                <logger level="INFO" doc:name="Route 1 Audit Logger" message="#['[Correlation ID: ' ++ vars.correlationId ++ '] Initializing parallel audit tracking for: ' ++ vars.sourceFileName]"/>
            </route>
            <route>
                <ee:transform doc:name="Route 2 Build Metadata Payload">
                    <ee:message>
                        <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  fileName: vars.sourceFileName,
  correlationId: vars.correlationId,
  status: "PARALLEL_INIT_COMPLETE",
  timestamp: now()
}]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </route>
        </scatter-gather>

        <!-- 2. Restore the raw file content back to the main payload -->
        <set-payload value="#[vars.filePayload]" doc:name="Restore File Payload"/>

        <flow-ref
            name="inventory-validate-file-flow"
            doc:name="Validate and Process Warehouse File"/>

    </flow>

</mule>